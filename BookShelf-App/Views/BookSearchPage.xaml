<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BookShelf.Models"
             x:Class="BookShelf.Views.BookSearchPage"
             Title="Search Books">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Grid.Row="0": Offline Warning Banner -->
        <Border x:Name="OfflineBanner"
                Grid.Row="0"
                BackgroundColor="#FFD2D2"
                Stroke="#D8000C"
                Padding="10"
                IsVisible="False"
                Margin="0,0,0,5">
            <Label Text="⚠️ You are currently offline. Search functionality requires an internet connection."
                   TextColor="#D8000C"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
        </Border>

        <!-- Grid.Row="1": App Heading -->
        <Label Grid.Row="1" 
               Text="BookShelf Search" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <!-- Grid.Row="2": Search Controls -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <SearchBar x:Name="BookSearchBar" 
                       Placeholder="Search title or author..." 
                       SearchButtonPressed="OnSearchClicked" />
            <Button Grid.Column="1" 
                    Text="Search" 
                    Clicked="OnSearchClicked" />
        </Grid>

        <!-- Grid.Row="3": Status & Loading -->
        <VerticalStackLayout Grid.Row="3" Spacing="5">
            <ActivityIndicator x:Name="LoadingIndicator" 
                               IsRunning="False" 
                               IsVisible="False" 
                               HorizontalOptions="Center" />
            <Label x:Name="StatusLabel" 
                   Text="Search for a book to get started." 
                   TextColor="Gray" 
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Grid.Row="4": Search Results -->
        <CollectionView x:Name="ResultsCollectionView" Grid.Row="4" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:BookSearchItem">
                    <Frame Margin="0,0,0,10" Padding="10" CornerRadius="8" BorderColor="LightGray">
                        <Grid ColumnDefinitions="80, *" ColumnSpacing="15">

                            <!-- Cover Image -->
                            <Image Grid.Column="0" 
                                   Source="{Binding CoverUrl}" 
                                   WidthRequest="80" 
                                   HeightRequest="110" 
                                   Aspect="AspectFill" />

                            <!-- Details & Actions -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Author}" TextColor="DimGray" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DisplayYear, StringFormat='Published: {0}'}" TextColor="Gray" FontSize="12" />

                                <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                                    <Button Text="View Details" 
                                            FontSize="12" 
                                            HeightRequest="35"
                                            Clicked="OnViewDetailsClicked" 
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Save" 
                                            FontSize="12" 
                                            HeightRequest="35"
                                            BackgroundColor="DarkSlateBlue"
                                            TextColor="White"
                                            Clicked="OnSaveBookClicked" 
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>