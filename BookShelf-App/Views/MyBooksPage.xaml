<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:BookShelf.Models"
             x:Class="BookShelf.Views.MyBooksPage"
             Title="My Reading List">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *" Padding="15" RowSpacing="10">

        <!-- Row 0: Header -->
        <Label Grid.Row="0" 
               Text="My Saved Books" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <!-- Row 1: Goal Tracker Widget -->
        <Border Grid.Row="1" BackgroundColor="#F0F4F8" Stroke="DarkSlateBlue" Padding="12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="5">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Annual Reading Challenge" FontAttributes="Bold" FontSize="14" TextColor="DarkSlateBlue" />
                    <Label x:Name="GoalProgressLabel" Grid.Column="1" Text="0 / 10 Completed" FontAttributes="Bold" FontSize="14" TextColor="DarkSlateBlue" />
                </Grid>
                <ProgressBar x:Name="GoalProgressBar" Progress="0.0" ProgressColor="DarkSlateBlue" HeightRequest="8" />
            </VerticalStackLayout>
        </Border>

        <!-- Row 2: Search & Status Filters -->
        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="10">
            <SearchBar x:Name="SavedSearchBar" 
                       Grid.Column="0" 
                       Placeholder="Search title or author..." 
                       TextChanged="OnFilterChanged" />
            <Picker x:Name="StatusFilterPicker" 
                    Grid.Column="1" 
                    Title="Filter by Status" 
                    SelectedIndexChanged="OnFilterChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>All</x:String>
                        <x:String>Want to Read</x:String>
                        <x:String>Reading</x:String>
                        <x:String>Completed</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <!-- Row 3: Extension Challenge - Sorting Dropdown -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto, *" ColumnSpacing="10" VerticalOptions="Center">
            <Label Text="Sort By:" VerticalOptions="Center" FontAttributes="Bold" FontSize="12" />
            <Picker x:Name="SortPicker" Grid.Column="1" SelectedIndex="0" SelectedIndexChanged="OnFilterChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Date Saved (Newest)</x:String>
                        <x:String>Title (A-Z)</x:String>
                        <x:String>Rating (Highest)</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </Grid>

        <!-- Row 4: Saved Books Collection -->
        <CollectionView x:Name="SavedBooksCollectionView" Grid.Row="4">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                    <Label Text="No saved books match your criteria." FontSize="18" TextColor="Gray" HorizontalOptions="Center" />
                    <Label Text="Try adjusting your filters or search for new books!" FontSize="14" TextColor="DarkGray" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SavedBook">
                    <Frame Margin="0,0,0,12" Padding="12" CornerRadius="8" BorderColor="LightGray">
                        <Grid ColumnDefinitions="120, *" ColumnSpacing="15">

                            <!-- Book Cover -->
                            <Image Grid.Column="0" 
                                   Source="{Binding DisplayCover}" 
                                   WidthRequest="120" 
                                   HeightRequest="170" 
                                   Aspect="AspectFit"
                                   VerticalOptions="Start" />

                            <!-- Info & Controls -->
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Author}" TextColor="DimGray" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DateSaved, StringFormat='Saved: {0:yyyy-MM-dd}'}" TextColor="Gray" FontSize="11" />

                                <!-- Status Picker with TwoWay Binding -->
                                <HorizontalStackLayout Spacing="8" Margin="0,2,0,0">
                                    <Label Text="Status:" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                                    <Picker SelectedItem="{Binding ReadingStatus, Mode=TwoWay}" 
                                            SelectedIndexChanged="OnStatusChanged" 
                                            FontSize="12" 
                                            HeightRequest="35"
                                            BindingContext="{Binding .}">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Want to Read</x:String>
                                                <x:String>Reading</x:String>
                                                <x:String>Completed</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </HorizontalStackLayout>

                                <!-- Rating Picker with TwoWay Binding -->
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="Rating:" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" />
                                    <Picker SelectedItem="{Binding Rating, Mode=TwoWay}" 
                                            SelectedIndexChanged="OnRatingChanged" 
                                            FontSize="12" 
                                            HeightRequest="35"
                                            BindingContext="{Binding .}">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:Int32}">
                                                <x:Int32>0</x:Int32>
                                                <x:Int32>1</x:Int32>
                                                <x:Int32>2</x:Int32>
                                                <x:Int32>3</x:Int32>
                                                <x:Int32>4</x:Int32>
                                                <x:Int32>5</x:Int32>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                    <Label Text="★" TextColor="Gold" VerticalOptions="Center" FontSize="14" />
                                </HorizontalStackLayout>

                                <!-- Notes & Remove Buttons -->
                                <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,5,0,0">
                                    <Button Text="Notes" 
                                            FontSize="12" 
                                            HeightRequest="32"
                                            BackgroundColor="DarkSlateBlue"
                                            TextColor="White"
                                            Clicked="OnEditNotesClicked" 
                                            CommandParameter="{Binding .}" />
                                    <Button Text="Remove" 
                                            FontSize="12" 
                                            HeightRequest="32"
                                            BackgroundColor="DarkRed"
                                            TextColor="White"
                                            Clicked="OnRemoveClicked" 
                                            CommandParameter="{Binding .}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>